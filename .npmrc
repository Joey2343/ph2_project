# ใช้ npm registry มาตรฐาน (registry.npmjs.org)
#
# เหตุผล: registry ภายในขององค์กรแคช tarball ของบางแพ็กเกจไม่ครบ
#          (เช่น mysql2 ตอนติดตั้งได้ 404) ทำให้ติดตั้งไม่ผ่าน
#
# ไฟล์นี้อยู่ที่รากโปรเจกต์ จึงมีผลกับทั้ง backend/ และ frontend/
registry=https://registry.npmjs.org/
package-lock=true

# ไม่ต้องยิง audit/funding เวลาติดตั้ง (เร็วขึ้น และไม่ต้องต่อ registry เพิ่ม)
audit=false
fund=false
