# ── การติดตั้งแพ็กเกจ ────────────────────────────────────────────────────────
node_modules/

# ── ผลลัพธ์การ build ของ frontend ───────────────────────────────────────────
frontend/dist/
frontend/.vite/
*.tsbuildinfo

# ── ค่าตั้งและข้อมูลลับ ─────────────────────────────────────────────────────
# .env มีรหัสผ่านฐานข้อมูลและ token ของ Telegram — ห้าม commit
.env
.env.local
.env.*.local

# ── ข้อมูล runtime ──────────────────────────────────────────────────────────
# ฐานข้อมูล MariaDB อยู่ใน Docker volume ไม่ได้อยู่ในโฟลเดอร์โปรเจกต์
# ถ้าต้องการสำรอง ให้ใช้:  docker exec ph2-mariadb mariadb-dump -uadmin_ph2 -padmin_ph2pass admin_ph2 > backup.sql
# ไฟล์สำรองไม่ควรอยู่ใน git
*.sql.dump
backup*.sql

# ── ไฟล์ที่ผู้ใช้อัปโหลด ────────────────────────────────────────────────────
# เป็นข้อมูลส่วนบุคคล/เอกสารจริง ไม่ควรอยู่ใน git
backend/public/uploads/

# ── สำรองก่อน refactor ──────────────────────────────────────────────────────
.backup-before-*/

# ── phpMyAdmin ───────────────────────────────────────────────────────────────
# phpMyAdmin เขียน config ที่ตัวเองตอนรัน (บันทัก session key)
# ไม่ควรอยู่ใน git และถ้าลบไป phpMyAdmin จะสร้างใหม่เองตอนเปิดใหม่
.phpmyadmin/

# ── บันทึกของระบบ ────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-error.log*
logs/
*.pid
.DS_Store
Thumbs.db

# ── โฟลเดอร์ชั่วคราว ───────────────────────────────────────────────────────
tmp/
.temp/
.cache/
coverage/
