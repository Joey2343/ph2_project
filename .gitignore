# ── การติดตั้งแพ็กเกจ ────────────────────────────────────────────────────────
node_modules/

# ── ผลลัพธ์การ build ของ frontend ───────────────────────────────────────────
frontend/dist/
frontend/.vite/
*.tsbuildinfo

# ── ค่าตั้งและข้อมูลลับ ─────────────────────────────────────────────────────
# .env มีรหัสผ่านฐานข้อมูลและ token ของ Telegram — ห้าม commit
.env
.env.local
.env.*.local

# ── ฐานข้อมูล SQLite ────────────────────────────────────────────────────────
# เป็นข้อมูล runtime (มี session, รหัสผ่าน) — เก็บแยกต่างหาก
# ถ้าต้องการฐานข้อมูลตัวอย่างสำหรับติดตั้งใหม่ ให้ copy เป็น data.sample.db แล้ว commit ไฟล์นั้นแทน
backend/data.db
backend/data.db-journal
backend/data.db-wal
backend/data.db-shm

# ── ไฟล์ที่ผู้ใช้อัปโหลด ────────────────────────────────────────────────────
# เป็นข้อมูลส่วนบุคคล/เอกสารจริง ไม่ควรอยู่ใน git
backend/public/uploads/

# ── บันทึกของระบบ ────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-error.log*
logs/
*.pid
.DS_Store
Thumbs.db

# ── โฟลเดอร์ชั่วคราว ───────────────────────────────────────────────────────
tmp/
.temp/
.cache/
coverage/
