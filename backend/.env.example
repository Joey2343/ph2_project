# ─────────────────────────────────────────────────────────────────────────────
# ตั้งค่าสำหรับ backend — คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามการใช้งาน
#
#   cp .env.example .env      (Windows: copy .env.example .env)
#
# .env ถูกใส่ใน .gitignore อยู่แล้ว ห้าม commit
# ─────────────────────────────────────────────────────────────────────────────

# ── ฐานข้อมูล (บังคับ) ───────────────────────────────────────────────────────
# ระบบใช้ MariaDB 11.4 ตัวเดียว ไม่มี SQLite หรือ MySQL แยกอีกแล้ว
# ไม่ตั้งค่านี้ = ระบบจะไม่ยอมเริ่มทำงาน
#
# DATABASE_URL=mysql://admin_ph2:admin_ph2pass@127.0.0.1:3308/admin_ph2
#
# ถ้าใช้ docker-compose.yml ที่มากับโปรเจกต์:
#   docker compose up -d
#   DATABASE_URL=mysql://admin_ph2:admin_ph2pass@127.0.0.1:3308/admin_ph2
#
# ฐานทดสอบ (ใช้กับ npm run verify) — ชื่อฐานต้องลงท้าย _test เสมอ
# เพราะตัวทดสอบเขียนและลบข้อมูล ถ้าชี้ผิดฐานจะไปลบข้อมูลจริงได้
# docker-compose สร้างฐานนี้ให้อัตโนมัติ
#
# SMOKE_DATABASE_URL=mysql://admin_ph2:admin_ph2pass@127.0.0.1:3308/admin_ph2_test

# ── ทางเลือกแบบแยกตัวแปร (ใช้แทน DATABASE_URL ได้ ถ้าตั้ง DATABASE_URL จะชนะ) ──
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=admin_ph2
# DB_PASSWORD=admin_ph2pass
# DB_NAME=admin_ph2
# DB_CONNECTION_LIMIT=10

# ── เซิร์ฟเวอร์ ──────────────────────────────────────────────────────────────
# พอร์ตที่ระบบฟัง (ค่าเริ่มต้น 3000)
PORT=3000

# ── Telegram (แจ้งเตือนอัตโนมัติ) ─────────────────────────────────────────────
# ไม่บังคับ — ถ้าไม่ตั้งระบบจะข้ามการแจ้งเตือน
# ได้ token จาก @BotFather
# TELEGRAM_BOT_TOKEN=1234567890:AAxxxxxx
# ถ้าใช้ผ่าน proxy ภายในองค์กร
# TELEGRAM_API_BASE=https://telegram.internal