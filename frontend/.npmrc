# ใช้ npm registry มาตรฐาน (registry.npmjs.org)
#
# ต้องมีไฟล์นี้ใน backend/ และ frontend/ แยกกัน เพราะ npm อ่าน .npmrc
# จากโฟลเดอร์ที่มี package.json เท่านั้น (ไม่ได้ไล่ขึ้นไปที่รากโปรเจกต์)
#
# เหตุผล: registry ภายในขององค์กรแคช tarball ของบางแพ็กเกจไม่ครบ
#         (leaflet.markercluster ได้ 404) ทำให้ติดตั้งไม่ผ่าน
registry=https://registry.npmjs.org/

audit=false
fund=false
